{
  "name": "ft_transcendence",
  "version": "1.0.0",
  "description": "3D poker game against several AI opponents, built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names jeu,serveur --prefix-colors yellow,cyan \"npm:dev:front\" \"npm:server\"",
    "dev:front": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ai:sync": "bash scripts/sync-mccfr.sh",
    "ai:analysis": "bash scripts/sync-analysis.sh",
    "test:ai": "node --test tests/*.test.mjs",
    "debug_ia": "vite --mode aidebug",
    "server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "ai:equity": "node scripts/equity-matrix.mjs",
    "docs:man": "node scripts/docs/build-man.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "vite": "^5.4.0"
  }
}
